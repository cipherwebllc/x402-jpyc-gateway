# OpenPay の discovery に登録する、クエリなしの完全な API URL
MY_RESOURCE_URL=https://your-gateway.example.com/api/consult

# OpenPay 出品一覧の dual-rail スニペットに表示される ID。空なら JPYC のみ
MY_RESOURCE_ID=

# coo-icp (default) または http
ADAPTER=coo-icp

# ADAPTER=coo-icp のとき必須
COO_CANISTER_ID=
IC_HOST=https://icp-api.io
# 強く推奨: ランダムな秘密値。未設定 (匿名 identity) だと coo-icp 側の会話履歴が
# 匿名 principal として誰からでも読めてしまう
IC_IDENTITY_SEED=

# ADAPTER=http のとき必須
UPSTREAM_URL=

# OpenPay ライセンス NFT 入場ゲート (必須 2 つ + 任意 2 つ)
# 既存デプロイも、デプロイ前に次の 2 変数を必ず設定
# OpenPay 商品 ID: h_ + 小文字 hex 32 桁 (^h_[0-9a-f]{32}$)
LICENSE_PRODUCT_ID=
# 32 UTF-8 bytes 以上の server-only ランダム秘密値
LICENSE_SESSION_SECRET=
# 任意: HTTP(S) RPC URL。空なら SDK の Polygon 既定 RPC
POLYGON_RPC_URL=
# 任意: descriptor 取得先。HTTPS origin のみ (パス・認証情報等は不可)
LICENSE_ORIGIN=https://open-pay.jp
# 署名の audience は MY_RESOURCE_URL の origin (引き続き必須)
# LICENSE_ORIGIN を変更しても productUrl / verifyUrl は open-pay.jp 配下が必須
# 環境変数不正・descriptor 取得失敗はいずれも起動失敗
# 復旧はプロセス/インスタンス再起動 (Vercel は次のコールドスタート)
# 次リクエストでの自動復旧は保証されない。nonce ストアの制約は README を参照
