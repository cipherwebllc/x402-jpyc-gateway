# OpenPay の discovery に登録する、クエリなしの完全な API URL
MY_RESOURCE_URL=https://your-gateway.example.com/api/consult

# 必須: 自分の OpenPay 出品一覧に表示される ID。前後の空白は不可。URL 検索へ戻らない
MY_RESOURCE_ID=

# 必須: 自分で管理する JPYC 受取ウォレット (0x + 40 桁の hex)。forwarder ではない
# accepts[].extra.openpay.merchant と照合する。discovery 応答から自動設定しない
# ゼロアドレス・既知の burn アドレスは受取先として設定できない
EXPECTED_RECIPIENT=

# 任意: 未設定・空なら JPYC のみ (USDC の取得・提示・支払い受付を行わない)
# 設定する場合は OpenPay 側 USDC 面に登録した自分の受取先と一致させる
# JPYC と同じ受取先なら EXPECTED_RECIPIENT と同じアドレスを設定する
EXPECTED_USDC_RECIPIENT=

# coo-icp (default) または http
ADAPTER=coo-icp

# ADAPTER=coo-icp のとき必須
COO_CANISTER_ID=
IC_HOST=https://icp-api.io
# 強く推奨: ランダムな秘密値。未設定 (匿名 identity) だと coo-icp 側の会話履歴が
# 匿名 principal として誰からでも読めてしまう
IC_IDENTITY_SEED=

# ADAPTER=http のとき必須
UPSTREAM_URL=
