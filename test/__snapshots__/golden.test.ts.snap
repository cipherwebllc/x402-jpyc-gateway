exports[`11b. /openapi.json caching and /api/consult interleaving > concurrent requests share one read 1`] = `
{
  "adapterCalls": [],
  "consoleErrors": [],
  "fetches": [
    {
      "body": null,
      "cache": "no-store",
      "hasSignal": true,
      "headers": {},
      "method": "GET",
      "url": "https://open-pay.jp/api/x402/relay/requirements?resourceId=resource-id",
    },
    {
      "body": null,
      "cache": "no-store",
      "hasSignal": true,
      "headers": {},
      "method": "GET",
      "url": "https://open-pay.jp/api/discovery/resource-id",
    },
  ],
  "requests": [
    {
      "at": "+0:00.000",
      "label": "A (requirements held)",
      "response": {
        "body": "{"openapi":"3.1.0","info":{"title":"gateway.example.com","version":"1.0.0","description":"Consultation","x-guidance":"Call GET /api/consult?q=<input>. The first call returns 402 with the x402 payment terms. Pay with an x402 client and retry the same URL. Settlement happens after the upstream responds, so an upstream failure is not settled."},"servers":[{"url":"https://gateway.example.com"}],"paths":{"/api/consult":{"get":{"operationId":"consult","summary":"Consultation","parameters":[{"name":"q","in":"query","required":true,"description":"Input passed to the upstream for this one paid request","schema":{"type":"string","minLength":1}}],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.05"},"protocols":[{"x402":{}}]},"responses":{"200":{"description":"Paid response","content":{"application/json":{"schema":{"type":"object","properties":{"answer":{"type":"string"}},"required":["answer"]}}}},"402":{"description":"Payment required. The response carries the x402 payment terms."}}}}}}",
        "headers": [
          [
            "cache-control",
            "no-store",
          ],
          [
            "content-type",
            "application/json",
          ],
        ],
        "status": 200,
        "statusText": "",
      },
      "url": "https://untrusted-request-host.example/openapi.json",
    },
    {
      "at": "+0:00.000",
      "label": "B while A reads",
      "response": {
        "body": "{"openapi":"3.1.0","info":{"title":"gateway.example.com","version":"1.0.0","description":"Consultation","x-guidance":"Call GET /api/consult?q=<input>. The first call returns 402 with the x402 payment terms. Pay with an x402 client and retry the same URL. Settlement happens after the upstream responds, so an upstream failure is not settled."},"servers":[{"url":"https://gateway.example.com"}],"paths":{"/api/consult":{"get":{"operationId":"consult","summary":"Consultation","parameters":[{"name":"q","in":"query","required":true,"description":"Input passed to the upstream for this one paid request","schema":{"type":"string","minLength":1}}],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.05"},"protocols":[{"x402":{}}]},"responses":{"200":{"description":"Paid response","content":{"application/json":{"schema":{"type":"object","properties":{"answer":{"type":"string"}},"required":["answer"]}}}},"402":{"description":"Payment required. The response carries the x402 payment terms."}}}}}}",
        "headers": [
          [
            "cache-control",
            "no-store",
          ],
          [
            "content-type",
            "application/json",
          ],
        ],
        "status": 200,
        "statusText": "",
      },
      "url": "https://untrusted-request-host.example/openapi.json",
    },
    {
      "at": "+1:00.000",
      "label": "C at 1:00",
      "response": {
        "body": "{"openapi":"3.1.0","info":{"title":"gateway.example.com","version":"1.0.0","description":"Consultation","x-guidance":"Call GET /api/consult?q=<input>. The first call returns 402 with the x402 payment terms. Pay with an x402 client and retry the same URL. Settlement happens after the upstream responds, so an upstream failure is not settled."},"servers":[{"url":"https://gateway.example.com"}],"paths":{"/api/consult":{"get":{"operationId":"consult","summary":"Consultation","parameters":[{"name":"q","in":"query","required":true,"description":"Input passed to the upstream for this one paid request","schema":{"type":"string","minLength":1}}],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.05"},"protocols":[{"x402":{}}]},"responses":{"200":{"description":"Paid response","content":{"application/json":{"schema":{"type":"object","properties":{"answer":{"type":"string"}},"required":["answer"]}}}},"402":{"description":"Payment required. The response carries the x402 payment terms."}}}}}}",
        "headers": [
          [
            "cache-control",
            "no-store",
          ],
          [
            "content-type",
            "application/json",
          ],
        ],
        "status": 200,
        "statusText": "",
      },
      "url": "https://untrusted-request-host.example/openapi.json",
    },
  ],
  "timeline": [
    "▶ A (requirements held)",
    "fetch requirements",
    "fetch discovery",
    "▶ B while A reads",
    "▶ C at 1:00",
  ],
}
`;

